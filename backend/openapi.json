    "/baskets/{basket_id}/returns": {
      "get": {
        "description": "Fixed-quantity portfolio value and price returns over [start, end]. The basket acts as a\nportfolio, so every member needs a target_quantity. With `as_of`, prices are read as they\nwere stored then.",
        "operationId": "portfolio_returns_baskets__basket_id__returns_get",
        "parameters": [
          {
            "in": "path",
            "name": "basket_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Basket Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "in": "query",
